+#ifdef NATIVE
+/* The 45 distinct techniques requested for visual previews. Hard Rain
+   (0x92) and Titanic Wave (0x94) are outside the requested list. */
+static const s32 nativePreviewTechs[] = {
+    0x89, 0x8A, 0x8B, 0x8C, 0x8D, 0x8E, 0x8F, 0x90,
+    0x91, 0x93, 0x95, 0x96, 0x97, 0x98, 0x99, 0x9A,
+    0x9B, 0x9C, 0x9D, 0x9E, 0x9F, 0xA0, 0xA1, 0xA2,
+    0xA3, 0xA4, 0xA5, 0xA6, 0xA7, 0xA8, 0xA9, 0xAA,
+    0xAB, 0xAC, 0xAD, 0xAE, 0xAF, 0xB0, 0xB1, 0xB2,
+    0xB3, 0xB4, 0xB5, 0xB6, 0xB7
+};
+enum {
+    NATIVE_PREVIEW_COUNT = sizeof(nativePreviewTechs) / sizeof(nativePreviewTechs[0]),
+    NATIVE_PREVIEW_VISIBLE = 14
+};
+static s32 nativePreviewCursor;
+static s32 nativePreviewScroll;
+
+/* Scroll through localized skill names with fourteen rows on screen. */
+void WFIGHTTS_techniqueList(BattleTestTechniqueList *task, TextWindow **windows) {
+    s32 pressed;
+    s32 i;
+    s32 steps;
+
+    switch (task->state) {
+    case 0:
+    default:
+        for (i = 0; i < NATIVE_PREVIEW_VISIBLE; i++) {
+            windows[i] = createTextWindow(BATTLE_LAYER_MENUS, 1, 0x90, 0x28 + i * 12);
+        }
+        task->nextState(task);
+        break;
+    case 1:
+        pressed = PAD.getPressed(0) | PAD.getRepeated(0);
+        steps = PAD.getHeld(0) & (1 << PAD_SQUARE) ? 10 : 1;
+        if (pressed & (1 << PAD_UP)) {
+            task->cursor -= steps;
+            if (task->cursor < 0) task->cursor = 0;
+        } else if (pressed & (1 << PAD_DOWN)) {
+            task->cursor += steps;
+            if (task->cursor >= NATIVE_PREVIEW_COUNT) task->cursor = NATIVE_PREVIEW_COUNT - 1;
+        } else if (pressed & (1 << PAD_CROSS)) {
+            *task->result = nativePreviewTechs[task->cursor];
+            task->setState(task, TASK_KILL);
+        } else if (pressed & (1 << PAD_TRIANGLE)) {
+            *task->result = -1;
+            task->setState(task, TASK_KILL);
+        }
+        if (task->cursor < task->scroll) task->scroll = task->cursor;
+        if (task->cursor >= task->scroll + NATIVE_PREVIEW_VISIBLE) {
+            task->scroll = task->cursor - NATIVE_PREVIEW_VISIBLE + 1;
+        }
+        nativePreviewCursor = task->cursor;
+        nativePreviewScroll = task->scroll;
+        for (i = 0; i < NATIVE_PREVIEW_VISIBLE; i++) {
+            if (task->cursor == task->scroll + i && (GFX.funcs.getTime() & 8)) {
+                windows[i]->setVisible(windows[i], 0);
+            } else {
+                windows[i]->setVisible(windows[i], 1);
+                windows[i]->setString(windows[i], FILE_CACHE.load(TEXT_FILE(TEXT_SKILL_NAMES)),
+                                      nativePreviewTechs[task->scroll + i]);
+            }
+        }
+        break;
+    case TASK_DONE:
+    case TASK_KILL:
+        break;
+    }
+}
+
+BattleTestTechniqueList *WFIGHTTS_createTechniqueList(s32 *result) {
+    BattleTestTechniqueList *task = createTaskWithId(
+        WFIGHTTS_techniqueList, sizeof(BattleTestTechniqueList),
+        NATIVE_PREVIEW_VISIBLE * sizeof(TextWindow *), 0xFFFF);
+
+    task->result = result;
+    task->cursor = nativePreviewCursor;
+    task->scroll = nativePreviewScroll;
+    return task;
+}
+#endif
 
