 #include "fightstg.h"
+
+#ifdef NATIVE
+/* The generated player scripts negate each original launch ID. Resolve the
+   marker for both preloads and playback, retaining the positive original as
+   the fallback when the technique map omits a field. */
+static s32 nativeLaunchId(BattleScript *script, s32 id, s32 field) {
+    if (id >= 0 || script->nativeTechId <= 0 || script->enemy != 0 ||
+        (script->index != 9 && script->index != 13)) {
+        return id;
+    }
+    return native_visual_get(script->nativeTechId, field, -id);
+}
+#endif
 
