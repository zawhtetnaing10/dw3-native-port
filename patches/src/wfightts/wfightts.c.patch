+#ifdef NATIVE
+/* Page 6 previews a named technique on the right-side fighter.
+   Scene Test has no damage calculation, so supply landed hit results while
+   using the same technique ID and visual map as a normal player attack. */
+static inline void runTechniquePage(BattleTest *task, BattleTestChildren *children) {
+    TechData *tech;
+    FighterInfo *fighterInfo;
+    s32 *scripts;
+    s32 id;
+
+    switch (task->step) {
+    case 0:
+    default:
+        task->page = 6;
+        task->technique = -1;
+        children->techniques = WFIGHTTS_createTechniqueList(&task->technique);
+        task->nextStep(task);
+        break;
+    case 1:
+        if (children->techniques != NULL && PAD.getPressed(0) & (1 << PAD_L1)) {
+            children->techniques->setState(children->techniques, TASK_KILL);
+            task->setSubstate(task, 5);
+        } else if (children->techniques != NULL && PAD.getPressed(0) & (1 << PAD_R1)) {
+            children->techniques->setState(children->techniques, TASK_KILL);
+            task->setSubstate(task, 4);
+        } else if (children->techniques == NULL) {
+            id = task->technique;
+            if (id > 0 && children->task.task == NULL) {
+                tech = &TECHS[id - 1];
+                fighterInfo = FIGHTSTG_fighterCache.funcs.getInfo(
+                    children->models->getFighter(children->models, 0));
+                if (fighterInfo->effects != 0) {
+                    scripts = FILE_CACHE.getEntry(fighterInfo->effects);
+                    if (scripts[0] != 0 &&
+                        (tech->script == 9 || tech->script == 13) &&
+                        scripts[tech->script] != 0) {
+                        children->task.script = FIGHTSTG_createBattleScript();
+                        children->task.script->index = tech->script;
+                        children->task.script->enemy = 0;
+                        children->task.script->nativeTechId = id;
+                        children->task.script->effect = native_visual_get(
+                            id, NATIVE_VIS_IMPACT_SPRITE, tech->scriptEffect);
+                        children->task.script->sound = native_visual_get(
+                            id, NATIVE_VIS_IMPACT_SOUND, tech->scriptSound);
+                        children->task.script->stage = native_visual_get(
+                            id, NATIVE_VIS_STAGE, tech->scriptStage);
+                        children->task.script->hits[0] = 0;
+                        children->task.script->hits[1] = 0;
+                        children->task.script->hits[2] = 0;
+                        children->task.script->hits[3] = 1;
+                        task->nextStep(task);
+                        break;
+                    }
+                }
+            }
+            task->setSubstate(task, 0);
+        }
+        break;
+    case 2:
+        if (children->task.task == NULL) task->setSubstate(task, 0);
+        break;
+    }
+}
+#endif
 
